# Copy to .env and fill in. Only DB_URI and JWT_SECRET are required in production.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local, Docker, or MongoDB Atlas).
# No MongoDB installed? Run `npm run dev:memory` instead of `npm run dev`.
DB_URI=mongodb://127.0.0.1:27017/sync

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API, comma-separated.
# The first one is used for links in emails (password reset, event links).
CLIENT_URL=http://localhost:3000

# Set to 1 when running behind a proxy or load balancer (Nginx, Render, ...). On Vercel it defaults to 1.
# TRUST_PROXY=0

# Live updates: 'socket' (default for local/Docker) or 'polling'.
# Defaults to 'polling' automatically on Vercel, which can't hold WebSockets.
# REALTIME=socket

# In-process job timers for long-running servers. On Vercel the same jobs run from
# Vercel Schedules instead (see vercel.json), which call /api/jobs/* with CRON_SECRET.
ENABLE_JOBS=true
CRON_SECRET=

# Public demo with shared accounts (like the live app). Reloads the demo data every
# night via /api/jobs/demo-reset, WIPING THE WHOLE DATABASE, and stops visitors
# changing demo accounts' passwords or roles. Never enable on a real deployment.
DEMO_MODE=false

# The campus's IANA time zone; demo event dates are set on this clock.
CAMPUS_TIMEZONE=Asia/Kolkata
# Place search prefers results near the campus and in these countries (comma-separated ISO codes).
CAMPUS_LATITUDE=26.5123
CAMPUS_LONGITUDE=80.2329
PLACES_COUNTRY_CODES=in
# Web Push (phone/desktop notifications). Generate once: npx web-push generate-vapid-keys
# Leave empty to keep push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Cover photo uploads (Vercel Blob). Create a Blob store in the Vercel dashboard and
# connect it to the API project; Vercel adds this for you. Empty = paste-a-URL only.
BLOB_READ_WRITE_TOKEN=
# Campus-only sign-up: comma-separated email domains (subdomains included). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

# Production only: return verification codes / reset links in API responses when
# SMTP isn't configured (handy for demos; turn off once email works).
EXPOSE_VERIFICATION_CODES=false

# Email for verification codes, password resets and notifications.
# Without it (in development) codes are shown in the app and emails are logged.
# Either a Brevo API key (Brevo -> Settings -> SMTP & API -> API Keys; MAIL_FROM must be
# a verified Brevo sender) or any SMTP server (Brevo -> Settings -> SMTP & API -> SMTP).
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Sync <no-reply@example.com>"

# AI assistant ("Ask Sync"). Leave AI_API_KEY empty to turn the assistant off.
# Works with any OpenAI-compatible Chat Completions API. The default is Google
# Gemini's free tier: create a key (no card needed) at https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# Other providers, for example:
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-5.4-mini
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1       AI_MODEL=openai/gpt-oss-120b
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=<provider/model>
#   Ollama      AI_BASE_URL=http://localhost:11434/v1            AI_MODEL=<local model>  AI_API_KEY=ollama
