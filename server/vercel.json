{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "regions": ["bom1"],
  "schedules": {
    "email-outbox": {
      "schedule": "*/15 * * * *",
      "path": "/api/jobs/email-outbox",
      "requestMethod": "GET"
    },
    "event-reminders": {
      "schedule": "0 * * * *",
      "path": "/api/jobs/event-reminders",
      "requestMethod": "GET"
    },
    "maintenance": {
      "schedule": "0 9 * * *",
      "timezone": "Asia/Kolkata",
      "path": "/api/jobs/maintenance",
      "requestMethod": "GET"
    },
    "demo-reset": {
      "schedule": "0 2 * * *",
      "timezone": "Asia/Kolkata",
      "path": "/api/jobs/demo-reset",
      "requestMethod": "GET"
    }
  }
}
