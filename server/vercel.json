{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "crons": [
    { "path": "/api/jobs/event-reminders", "schedule": "0 7 * * *" },
    { "path": "/api/jobs/email-outbox", "schedule": "30 7 * * *" },
    { "path": "/api/jobs/maintenance", "schedule": "30 3 * * *" },
    { "path": "/api/jobs/demo-reset", "schedule": "30 20 * * *" }
  ]
}
