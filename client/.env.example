# Base URL of the Sync API (the `server/` app), reachable from the browser.
# Local: http://localhost:4000   Production: https://sync-campus-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# This app's own public address. Used for canonical links and link previews
# when someone shares an event page. Production: https://sync-campus.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show one-click demo account buttons on the sign-in page.
# Only useful with data from `npm --prefix server run seed`.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
